# Target Movie & Location Configuration
MOVIE_NAME=Jailer 2
MOVIE_CITY=Coimbatore

# Direct BookMyShow buytickets page (Movie showtimes URL or direct Cinema URL)
BOOKING_URL=https://in.bookmyshow.com/cinemas/COIM/karpagam-theatres-4k-dolby-atmos-coimbatore/buytickets/KARP/20261015

# Cinema text to search for
TARGET_CINEMA=Karpagam

# Showtime filter: only notify when a showtime before this cutoff is found
TARGET_TIME_BEFORE=10:00 AM

# Interval between repeated alerts in seconds (default: 2s, e.g. set 1 for every 1s)
ALERT_INTERVAL_SECONDS=2

# Optional: Set to true for headless cloud servers (Render, Railway, VPS)
HEADLESS=false

# Twilio API Credentials (optional, for SMS / WhatsApp alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Telegram Bot API Token (optional)
TELEGRAM_BOT_TOKEN=
